# Copy to .env. The app boots with none of these set.
# Postgres, Stripe, Resend, and OpenAI are optional for local UI work.
# Never commit real keys. Stripe must be a test key (sk_test_...).

# Server
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-me

# Postgres. Leave unset to use the in-memory catalog and order desk.
# Replit sets this automatically. Required for `npm run db:push` and `tsx server/seed.ts`.
# DATABASE_URL=postgres://user:password@localhost:5432/irmas

# Stripe test mode only. A live secret (sk_live_...) is refused.
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
# The publishable key is unused: checkout is a Stripe-hosted redirect.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Order confirmation email. Without a key, the send is a no-op and the order still saves.
# On Replit, the Resend connector is used when RESEND_API_KEY is unset.
# RESEND_API_KEY=re_
# RESEND_FROM_EMAIL="Irma's Pizzelles <orders@irmaspizzelles.com>"

# Newsletter generation. The server imports cleanly without these.
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Order desk at /v/admin. Send this value as the x-admin-token header.
# ADMIN_TOKEN=replace-me

# Pre-order knobs
EARLY_BIRD_PERCENT=18
BATCH_CAPACITY_DOZENS=80
BATCH_LABEL=Soft launch — Batch 01
# ISO timestamp. Leave unset to keep the batch open.
# PREORDER_CUTOFF=2026-12-31T23:59:59-05:00
# Comma-separated ZIP prefixes for local delivery. Default is Tampa Bay.
# LOCAL_DELIVERY_ZIPS=335,336,337,338,342,346
